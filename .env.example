# Copy this file to .env.local and fill in from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is only used server-side (import route, admin actions) - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
